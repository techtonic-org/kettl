# Garmin Connect credentials
GARMIN_EMAIL=your-email@example.com
GARMIN_PASSWORD=your-password

# How far back to sync Garmin data (default: 6 months ago)
# First sync can take a long time with years of history
GARMIN_START_DATE=2024-01-01

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Gemini API
GEMINI_API_KEY=your-gemini-api-key

# Mem0 (use mem0 hostname when running with Docker Compose)
MEM0_URL=http://mem0:8080

# GarminDB path
GARMINDB_PATH=~/.garmindb/garmin.db
